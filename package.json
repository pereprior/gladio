{
  "name": "gladio",
  "version": "0.0.1",
  "description": "Personal sports odds observatory",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "imports": {
    "#src/*": "./dist/*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run --project=unit",
    "test:e2e": "pnpm build && vitest run --project=e2e",
    "test:coverage": "pnpm build && vitest run --coverage",
    "test:watch": "vitest --project=unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pre-commit": "pnpm lint && pnpm format:check",
    "ci": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm format:check"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.1.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
